{
  "name": "storybook-addon-paddings",
  "version": "0.0.0-development",
  "description": "Add paddings to view components under different white space settings",
  "keywords": [
    "storybook-addon",
    "style",
    "padding",
    "margin",
    "spacing",
    "whitespace"
  ],
  "homepage": "https://github.com/rbardini/storybook-addon-paddings",
  "bugs": {
    "url": "https://github.com/rbardini/storybook-addon-paddings/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rbardini/storybook-addon-paddings.git"
  },
  "license": "MIT",
  "author": {
    "name": "Rafael Bardini",
    "email": "rafael@rbardini.com",
    "url": "https://rbardini.com/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsdown",
    "build:watch": "npm run build -- --watch",
    "build-storybook": "storybook build",
    "clean": "rimraf ./dist",
    "format": "prettier --ignore-path .gitignore --write .",
    "format-check": "prettier --ignore-path .gitignore --check .",
    "package-check": "package-check",
    "prepare": "husky",
    "start": "concurrently \"npm run build:watch\" \"npm run storybook -- --quiet\"",
    "storybook": "storybook dev -p 6006",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@skypack/package-check": "^0.2.0",
    "@storybook/addon-docs": "next",
    "@storybook/react-vite": "next",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.1.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "storybook": "next",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "storybook": "^11.0.0"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.ts"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ]
  },
  "storybook": {
    "displayName": "Paddings",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact",
      "react-native"
    ],
    "icon": "https://raw.githubusercontent.com/rbardini/storybook-addon-paddings/HEAD/icon.svg"
  }
}
